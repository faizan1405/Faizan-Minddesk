# ============================================================================
# MindDesk — Environment Variables Template (Hostinger MySQL + Better Auth)
# ============================================================================
# SECURITY RULES:
# 1. Copy this file to `.env.local` for local development.
# 2. In production, configure these variables in Hostinger hPanel -> Node.js.
# 3. NEVER commit `.env` or `.env.local` to Git.
# 4. NEVER expose `DATABASE_URL`, `BETTER_AUTH_SECRET`, or `SMTP_PASS` in
#    client-visible `NEXT_PUBLIC_*` variables.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. MySQL Database Connection (Prisma ORM — Server-Side Only)
# ----------------------------------------------------------------------------
# Local Development Example:
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/minddesk_dev"
#
# Hostinger Production Example (use 127.0.0.1 when Node.js & MySQL share the same Hostinger server):
# Notice: Hostinger assigns a specific prefixed username that differs from the database name:
# e.g., Database: u256504187_minddesk | Database User: u256504187_u987654321_min
# DATABASE_URL="mysql://u256504187_u987654321_min:YOUR_PASSWORD@127.0.0.1:3306/u256504187_minddesk"
DATABASE_URL="mysql://your-mysql-user:your-mysql-password@127.0.0.1:3306/your-database-name"

# ----------------------------------------------------------------------------
# 2. Better Auth Configuration (Server-Side Secret + Canonical Origin)
# ----------------------------------------------------------------------------
# Generate a strong secret (minimum 32 characters): `openssl rand -base64 32`
BETTER_AUTH_SECRET="replace-with-a-random-32-character-secret-key"

# Canonical server origin used by Better Auth for session cookies & callbacks
# Local: http://localhost:3000 | Production: https://your-domain.com
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# 3. SMTP Email Configuration (Optional in Local Dev, Recommended in Production)
#    Used for email verification and password recovery links.
#    Works directly with Hostinger Email (`smtp.hostinger.com`).
# ----------------------------------------------------------------------------
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@your-domain.com"
SMTP_PASS="replace-with-your-smtp-password"
SMTP_FROM="MindDesk <noreply@your-domain.com>"

# ----------------------------------------------------------------------------
# 4. Optional Live Database Test Flag (Local / CI Only)
# ----------------------------------------------------------------------------
MINDDESK_RUN_LIVE_DB_TESTS="false"
