# ============================================================================
# MindDesk — Environment Variables Template
# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit .env.local or expose service-role keys in NEXT_PUBLIC_* vars.
# ============================================================================

# Required: Supabase Project URL and Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required: Canonical Application Origin (used for email confirmation & password reset redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional (Server-only / CI RLS integration testing — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=
